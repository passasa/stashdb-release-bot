# Configuration du bot : copiez ce fichier en `.env` et remplissez-le.
# `.env` n'est jamais versionné (voir .gitignore) : il contient des secrets.

# ── Discord (requis) ───────────────────────────────────────────────────────

# Token du bot, dans la page « Bot » de la console Discord.
DISCORD_TOKEN=

# ID de l'APPLICATION Discord du bot (page « General Information »).
CLIENT_ID=

# ── StashDB (requis) ───────────────────────────────────────────────────────

STASH_ENDPOINT=https://stashdb.org/graphql

# Clé API du compte StashDB dont les favoris (studios, interprètes) sont suivis.
# Pour suivre un studio ou un interprète : le mettre en favori sur StashDB.
STASH_API_KEY=

# ── Réglages facultatifs ───────────────────────────────────────────────────

# Suivre aussi les interprètes favoris (true par défaut). false = studios seuls.
# FOLLOW_PERFORMERS=true

# Intervalle de vérification en ms (1 h par défaut, 5 min minimum).
# POLL_STASHDB_MS=3600000

# Âge maximal d'une sortie annoncée, en jours (30 par défaut).
# RELEASES_MAX_AGE_DAYS=30

# Fuseau qui décide si une scène est « sortie aujourd'hui ».
# BOT_TIMEZONE=Europe/Paris

# IDs des serveurs Discord autorisés, séparés par des virgules (vide = tous).
# Le bot quitte tout autre serveur.
# ALLOWED_GUILDS=

# Répertoire où vit bot.db.
# Par défaut : ./data. En Docker, le compose le pose sur /data.
# BOT_DATA_DIR=
